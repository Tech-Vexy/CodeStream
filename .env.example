# ---------------------------------------------------------------------------
# CodeStream local/deployment configuration
# Copy this file to .env for local development. Never commit real secrets.

NODE_ENV=development
PORT=3000

# MongoDB Atlas (or mongodb://127.0.0.1:27017 locally)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=codestream

# Temporal Cloud or a local Temporal server.
# TEMPORAL_ADDRESS=your-namespace.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=your-namespace
# TEMPORAL_API_KEY=replace-with-temporal-api-key
# For self-hosted TLS setups, use the Temporal envconfig variables supported
# by the SDK (for example TEMPORAL_TLS_CA, TEMPORAL_TLS_CERT, and TEMPORAL_TLS_KEY).
TEMPORAL_TASK_QUEUE=codestream

# OAuth App credentials (recommended for hosted deployments).
# Register https://your-domain.example/auth/github/callback in GitHub.
# When configured with SESSION_SECRET, OAuth takes precedence over CODESTREAM_API_TOKEN.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
# SESSION_SECRET=replace-with-at-least-32-random-characters

# Legacy shared API token. Leave unset when using GitHub OAuth.
# CODESTREAM_API_TOKEN=replace-with-a-long-random-token

# Model router and Google provider credentials.
CODESTREAM_MODEL=google/gemma-4-31b-it
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_CHUNK_CHARS=24000
LLM_CONCURRENCY=2
CODEBASE_MAX_CHARS=600000
CHANGES_MAX_CHARS=400000

# GitHub access. Anonymous access works for public repositories with lower rate limits.
# A fine-grained token needs read access to private repository contents.
GITHUB_TOKEN=

# Optional narration. Casts still work without these values, but have no audio.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Voice Q&A agent (ElevenAgents, not yet wired up). The agent LLM runs inside ElevenLabs, which does
# not host Gemma; spoken conversation uses gemini-3.8-flash while Gemma (CODESTREAM_MODEL) does all
# code analysis and answers in this stack.
ELEVENLABS_AGENT_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_AGENT_LLM=gemini-3.8-flash

# Optional Q&A retrieval embeddings (Voyage AI). Without a key, Q&A falls back to Gemma's chunk notes.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-code-3
VOYAGE_EMBEDDING_DIMENSIONS=1024

# Optional Sentry observability. Disabled unless SENTRY_ENABLED=true and a DSN is set.
SENTRY_ENABLED=false
SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.2
